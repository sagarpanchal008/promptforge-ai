# Google Gemini API Configuration (Required for Optimizer Agent, AI Security Audit & A/B Playground)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SQLite Persistence Path
DATABASE_PATH=database/prompt_vault.db

# FastAPI Backend CORS Origins
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501